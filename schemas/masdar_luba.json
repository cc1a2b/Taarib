{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cc1a2b/taarib/main/schemas/masdar_luba.json",
  "title": "MasdarLuba",
  "description": "Where a game came from, keeping that launcher's own identifier intact.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "steam"
        },
        "muarrif": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "Steam, by application identifier."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "epic"
        },
        "muarrif": {
          "type": "string"
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "The Epic Games Store, by catalogue item identifier."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "gog"
        },
        "muarrif": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "GOG, by product identifier."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "ea"
        },
        "muarrif": {
          "type": "string"
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "The EA app, by content identifier."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "ubisoft"
        },
        "muarrif": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "Ubisoft Connect, by installation identifier."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "battle_net"
        },
        "muarrif": {
          "type": "string"
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "Battle.net, by product code."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "xbox"
        },
        "muarrif": {
          "type": "string"
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "The Microsoft Store, by package family name."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "itch"
        },
        "muarrif": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "itch.io, by game identifier."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "amazon"
        },
        "muarrif": {
          "type": "string"
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "Amazon Games, by the product ASIN its own catalogue keys on."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "rockstar"
        },
        "muarrif": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "The Rockstar Games Launcher, by title identifier."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "riot"
        },
        "muarrif": {
          "type": "string"
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "The Riot client, by product slug — `valorant`, `league_of_legends`."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "heroic"
        },
        "muarrif": {
          "$ref": "#"
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "Heroic, which manages games that belong to another store; the wrapped source is the real identity, and Heroic is how it is installed."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "lutris"
        },
        "muarrif": {
          "$ref": "#/$defs/MasdarLutris"
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "Lutris, which does the same for a much wider set of sources, including ones with no store behind them at all."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "bottles"
        },
        "muarrif": {
          "type": "string"
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "Bottles, which manages Wine prefixes rather than games; the identity is the bottle's name and the program's path inside it."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "legendary"
        },
        "muarrif": {
          "$ref": "#"
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "Legendary, the command-line Epic client. Its catalogue is Epic's, so the wrapped source is always an [`MasdarLuba::Epic`]."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "playnite"
        },
        "muarrif": {
          "$ref": "#/$defs/MasdarPlaynite"
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "Playnite, a library manager that aggregates every other launcher."
    },
    {
      "type": "object",
      "properties": {
        "manassa": {
          "type": "string",
          "const": "yadawi"
        },
        "muarrif": {
          "type": "string"
        }
      },
      "required": [
        "manassa",
        "muarrif"
      ],
      "description": "A game the user pointed at directly, identified by a hash of its executable path so that the identity is stable across restarts."
    }
  ],
  "$defs": {
    "MasdarLutris": {
      "type": "object",
      "properties": {
        "silaa": {
          "type": "string",
          "description": "Lutris's own slug for the entry, always present."
        },
        "asl": {
          "anyOf": [
            {
              "$ref": "#"
            },
            {
              "type": "null"
            }
          ],
          "description": "The store behind it, when Lutris records one."
        }
      },
      "required": [
        "silaa"
      ],
      "description": "What a Lutris entry actually is."
    },
    "MasdarPlaynite": {
      "type": "object",
      "properties": {
        "muarrif": {
          "type": "string",
          "description": "Playnite's own GUID for the entry, always present."
        },
        "asl": {
          "anyOf": [
            {
              "$ref": "#"
            },
            {
              "type": "null"
            }
          ],
          "description": "The store behind it, when Playnite's plugin recorded one."
        }
      },
      "required": [
        "muarrif"
      ],
      "description": "What a Playnite entry actually is."
    }
  }
}
