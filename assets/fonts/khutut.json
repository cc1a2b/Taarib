        { "wazn": 500, "namat": "asli", "malaf": "latin/IBMPlexSans-Medium.ttf" },
        { "wazn": 600, "namat": "asli", "malaf": "latin/IBMPlexSans-SemiBold.ttf" }
      ],
      "sifat": ["ccmp", "locl", "liga", "kern", "mark"],
