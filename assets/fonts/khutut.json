      "aila": "IBM Plex Sans Arabic",
      "sinf": "sans",
      "istikhdam": ["wajiha"],
      "mutaghayyir": false,
      "awzan": [400, 500, 600],
      "milaffat": [
        { "wazn": 400, "namat": "asli", "malaf": "sans/IBMPlexSansArabic-Regular.ttf" },
        { "wazn": 500, "namat": "asli", "malaf": "sans/IBMPlexSansArabic-Medium.ttf" },
        { "wazn": 600, "namat": "asli", "malaf": "sans/IBMPlexSansArabic-SemiBold.ttf" }
      ],
      "sifat": ["ccmp", "locl", "fina", "medi", "init", "rlig", "calt", "liga", "kern", "mark", "mkmk"],
      "nitaqat": ["U+0000-00FF", "U+0600-06FF", "U+0750-077F", "U+08A0-08FF", "U+FB50-FDFF", "U+FE70-FEFF", "U+2000-206F"],
      "lughat": ["ar", "fa", "ur"],
      "rukhsa": "OFL-1.1",
      "malaf_rukhsa": "sans/IBMPlex-OFL.txt",
      "masdar": "https://github.com/IBM/plex",
      "isdar_khatt": "1.005",
      "sabab": "Drawn for interface work rather than display: low-contrast strokes, open counters, and a Latin companion that shares its vertical metrics, so a mixed Arabic-Latin line does not visibly step."
    },
