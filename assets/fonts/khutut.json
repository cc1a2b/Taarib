      "sifat": ["ccmp", "locl", "fina", "medi", "init", "rlig", "liga", "kern", "mark", "mkmk"],
      "nitaqat": ["U+0000-00FF", "U+0600-06FF", "U+0750-077F", "U+0870-089F", "U+08A0-08FF", "U+FB50-FDFF", "U+FE70-FEFF"],
      "lughat": ["ar", "fa", "ur"],
      "rukhsa": "OFL-1.1",
      "malaf_rukhsa": "naskh/OFL.txt",
      "masdar": "https://github.com/notofonts/arabic",
      "isdar_khatt": "2.021",
      "sabab": "The default for game text. Complete mark and mark-to-mark positioning, and the broadest Arabic-script coverage bundled: it and Noto Sans Arabic are the only two faces here that carry the whole of U+0600-06FF together with the Arabic Supplement and both Extended blocks, which makes it the safe choice when a translator has not chosen a font themselves. It attaches marks but does not attach letters: it carries no GPOS cursive lookups, so a joining stroke is drawn by the glyph rather than positioned by the font."
    },
    {
      "muarrif": "Amiri",
      "aila": "Amiri",
      "sinf": "naskh",
      "istikhdam": ["luba"],
      "mutaghayyir": false,
      "awzan": [400, 700],
      "milaffat": [
        { "wazn": 400, "namat": "asli", "malaf": "naskh/Amiri-Regular.ttf" },
        { "wazn": 400, "namat": "maail", "malaf": "naskh/Amiri-Italic.ttf" },
        { "wazn": 700, "namat": "asli", "malaf": "naskh/Amiri-Bold.ttf" },
        { "wazn": 700, "namat": "maail", "malaf": "naskh/Amiri-BoldItalic.ttf" }
      ],
      "sifat": ["ccmp", "locl", "fina", "medi", "init", "rlig", "liga", "curs", "kern", "mark", "mkmk"],
      "nitaqat": ["U+0000-00FF", "U+0600-06FF", "U+0750-077F", "U+08A0-08FF", "U+FB50-FDFF", "U+FE70-FEFF"],
      "lughat": ["ar", "fa", "ur"],
      "rukhsa": "OFL-1.1",
      "malaf_rukhsa": "naskh/Amiri-OFL.txt",
      "masdar": "https://github.com/aliftype/amiri",
      "isdar_khatt": "1.002",
      "sabab": "A revival of a classical Naskh with a substitution table deep enough to demonstrate what real shaping does: hundreds of required ligatures and stylistic-set forms that no presentation-form pipeline can reach. It is the only bundled family with GPOS cursive attachment, which is what lets a descending stroke meet the next letter at the height the calligraphy wants rather than at a fixed baseline. It is also the family that best suits narrative and dialogue text."
    },
