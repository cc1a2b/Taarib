      "aila": "Reem Kufi",
      "sinf": "kufi",
      "istikhdam": ["luba"],
      "mutaghayyir": true,
      "mihwar": [{ "ism": "wght", "min": 400, "aqsa": 700, "iftiradi": 400 }],
      "awzan": [400, 500, 600, 700],
      "milaffat": [
        { "wazn": 400, "namat": "asli", "malaf": "kufi/ReemKufi[wght].ttf" }
      ],
      "sifat": ["ccmp", "locl", "fina", "medi", "init", "rlig", "rclt", "kern", "mark", "mkmk"],
      "nitaqat": ["U+0000-00FF", "U+0600-06FF"],
      "lughat": ["ar"],
      "rukhsa": "OFL-1.1",
      "malaf_rukhsa": "kufi/ReemKufi-OFL.txt",
      "masdar": "https://github.com/aliftype/reem-kufi",
      "isdar_khatt": "2.000",
      "sabab": "A modern Kufi that actually joins — the four joining forms plus a required-contextual pass — rather than the disconnected letterforms most display Kufis ship, which means it can carry a full sentence and not only a title. The 2.000 redesign carries 118 of the 256 codepoints in the core Arabic block and nothing outside it — no Supplement, no presentation forms — so it is a display face and never a fallback."
    },
    {
