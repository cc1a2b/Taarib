      "milaffat": [
        { "wazn": 400, "namat": "asli", "malaf": "kufi/NotoKufiArabic[wght].ttf" }
      ],
      "sifat": ["ccmp", "locl", "fina", "medi", "init", "rlig", "liga", "kern", "mark", "mkmk"],
      "nitaqat": ["U+0000-00FF", "U+0600-06FF", "U+0750-077F", "U+08A0-08FF", "U+FE70-FEFF"],
      "lughat": ["ar", "fa", "ur"],
      "rukhsa": "OFL-1.1",
      "malaf_rukhsa": "kufi/OFL.txt",
      "masdar": "https://github.com/notofonts/arabic",
      "isdar_khatt": "2.109",
      "sabab": "Geometric, low-contrast, and legible at the small sizes interface chrome uses. The heavy weights hold up in a game's headings where a Naskh would look ornamental."
    },
    {
