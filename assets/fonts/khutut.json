      ],
      "awzan": [100, 200, 300, 400, 500, 600, 700, 800, 900],
      "milaffat": [
        { "wazn": 400, "namat": "asli", "malaf": "sans/NotoSansArabic[wdth,wght].ttf" }
      ],
      "sifat": ["ccmp", "locl", "fina", "medi", "init", "rlig", "liga", "kern", "mark", "mkmk"],
      "nitaqat": ["U+0000-00FF", "U+0600-06FF", "U+0750-077F", "U+0870-089F", "U+08A0-08FF", "U+FB50-FDFF", "U+FE70-FEFF"],
      "lughat": ["ar", "fa", "ur"],
      "rukhsa": "OFL-1.1",
      "malaf_rukhsa": "sans/OFL.txt",
      "masdar": "https://github.com/notofonts/arabic",
      "isdar_khatt": "2.012",
      "sabab": "The width axis is the reason this family is bundled: an interface string that overflows its container can be condensed by the font's own designed narrow instance instead of being scaled, which keeps stroke weight consistent with the rest of the screen."
    },
