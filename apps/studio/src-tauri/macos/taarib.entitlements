<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the hardened runtime on a Developer ID build. Not a Mac App
  Store build and not sandboxed: Taarib reads and writes inside game folders the
  user points it at, anywhere on disk, which App Sandbox cannot express.

  Nothing is granted that the code does not use. There is no JIT, no unsigned
  executable memory, no library validation exception, no camera, no microphone,
  no location, no address book, and no Apple Events — the studio never scripts
  another application.
-->
<plist version="1.0">
<dict>
	<!-- The registry, the forge, the update channel: all outbound HTTPS. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Signing keys live in the login keychain via the keyring crate; the
	     access group is the app's own, so nothing else can read them. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.cc1a2b.taarib</string>
	</array>
</dict>
</plist>
